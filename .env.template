# 1Password reference template — resolved at runtime by `make`.
#
# Contains ONLY 1Password references; no secret values. Safe to commit.
# OP_VAULT defaults to "liquidation-bot" (set in Makefile). Override
# per-environment via:
#   OP_VAULT=liquidation-bot-staging make run-docker
#
# To use this template:
#   - For docker:           `make run-docker` (auto-runs `make env-resolve`)
#   - For local flask dev:  `make dev`
#   - To regenerate .env:   `make env-resolve`
#
# Adding a key:
#   1. Create the item in the vault: op item create --category=password \
#        --title=NEW_KEY --vault=$OP_VAULT 'password=<value>'
#   2. Add the line below.

# Plaintext config (not a secret) — used by `forge test`, not by the bot at runtime.
FOUNDRY_PROFILE=mainnet

# Liquidation EOA — Tier-1 secrets, MUST live in 1Password.
LIQUIDATOR_EOA=op://${OP_VAULT}/LIQUIDATOR_EOA/password
LIQUIDATOR_PRIVATE_KEY=op://${OP_VAULT}/LIQUIDATOR_PRIVATE_KEY/password

# RPC URLs — Tier-2 (contain provider keys).
MAINNET_RPC_URL=op://${OP_VAULT}/MAINNET_RPC_URL/password
BASE_RPC_URL=op://${OP_VAULT}/BASE_RPC_URL/password

# 1inch swap aggregator API key — Tier-2.
ONEINCH_API_KEY=op://${OP_VAULT}/ONEINCH_API_KEY/password

# Notification + dashboard — required by config_loader; set to "disabled" or
# similar in 1Password if you don't use them rather than removing the items.
NOTIFICATION_URL=op://${OP_VAULT}/NOTIFICATION_URL/password
RISK_DASHBOARD_URL=op://${OP_VAULT}/RISK_DASHBOARD_URL/password
SLACK_MENTION_IDS=op://${OP_VAULT}/SLACK_MENTION_IDS/password
TWYNE_EOA_VAULTS=op://${OP_VAULT}/TWYNE_EOA_VAULTS/password

# Sentry error tracking. DSN is a write-only project identifier (Tier-2).
# SENTRY_RELEASE is injected by the Makefile from the git SHA at deploy time.
SENTRY_DSN=op://${OP_VAULT}/SENTRY_DSN/password
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.0
